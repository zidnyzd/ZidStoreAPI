#!/bin/bash

# Fungsi untuk mendapatkan sesi SSH/Dropbear aktif via who + ss (works on all distros, Debian 13+ too)
get_active_ssh_sessions() {
    who -u 2>/dev/null | awk '
    {
        user = $1
        pid = $6
        host = (NF >= 7) ? $7 : ""
        gsub(/[()]/, "", host)
        if (host != "" && host != ":0" && host != ":0.0") {
            print pid, user, host
        }
    }' | while read -r pid user host; do
        proc=$(ps -p "$pid" -o comm= 2>/dev/null)
        case "$proc" in
            sshd|dropbear) echo "$pid $user $host" ;;
        esac
    done
}

if [ -f '/root/.vars' ]; then
    source '/root/.vars'
    while true; do
        > /tmp/ssh_log_limit
        get_active_ssh_sessions | sort -k2 -k1 > /tmp/ssh_log_limit

        if [[ -s /tmp/ssh_log_limit ]]; then
            user_list=($(grep '^###' /etc/ssh/.ssh.db 2>/dev/null | cut -d ' ' -f 2 | sort -u))
            for user in "${user_list[@]}"; do
                ip_count=$(grep -cw "$user" /tmp/ssh_log_limit)
                ip_limit=$(cat "/etc/ssh/${user}" 2>/dev/null || echo 0)

                if [[ $ip_limit -ne 0 && $ip_count -gt $ip_limit ]]; then
                    echo "User $user exceeds IP limit. IP count: $ip_count, Limit: $ip_limit"

                    message="
<b>━━━━━━━━━━━━━━━━━━</b> 
<b>🔔 SSH NOTIFICATION </b>
<b>🚫 Multi Login User</b>
<b>━━━━━━━━━━━━━━━━━━</b> 
<b>👤 USERNAME :</b> <code>$user</code>
<b>📊 TOTAL IP :</b> <code>$ip_count</code>
<b>🔒 IP LIMIT :</b> <code>$ip_limit</code>
<b>━━━━━━━━━━━━━━━━━━</b> 
"
                    curl -s -X POST "https://api.telegram.org/bot$bot_token/sendMessage" \
                        -d "chat_id=$telegram_id" \
                        -d "parse_mode=HTML" \
                        -d "text=$message"
                fi
            done
        fi

        rm -f /tmp/ssh_log_limit
        sleep ${1}m
    done
else
    echo "Setting up Telegram Bot first"
fi
