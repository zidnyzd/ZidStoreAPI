        # Function to change VPS domain
        change_domain() {
            clear
            echo -e "${orange}─────────────────────────────────────────${neutral}"
            echo -e "${green}      .:::. CHANGE VPS DOMAIN .:::.      ${neutral}"
            echo -e "${orange}─────────────────────────────────────────${neutral}"
            echo -e ""
            read -p "  Enter New Domain: " new_domain

            if [ -z "$new_domain" ]; then
                echo -e "  ${red}Error: Domain cannot be empty${neutral}"
                read -n 1 -s -r -p "Press any key to return"
                return 1
            fi

            current_domain=$(cat /etc/xray/domain)
            if [ "$new_domain" = "$current_domain" ]; then
                echo -e "\n  ${yellow}The entered domain is the same as the current domain.${neutral}"
                read -p "  Do you want to renew the certificate? (y/n): " renew_cert
                if [[ $renew_cert =~ ^[Yy]$ ]]; then
                    echo -e "\n  ${green}Processing certificate renewal...${neutral}"
                else
                    echo -e "\n  ${green}No changes were made.${neutral}"
                    read -n 1 -s -r -p "Press any key to return to the menu"
                    return 0
                fi
            else
                echo -e "\n  ${green}Processing domain change...${neutral}"
                echo -e ""
            fi

            # Function to display loading animation
            show_loading() {
                local pid=$1
                local message=$2
                local delay=0.1
                local spinstr='|/-\'
                while [ "$(ps a | awk '{print $1}' | grep $pid)" ]; do
                    local temp=${spinstr#?}
                    printf " %s [%c]  " "$message" "$spinstr"
                    local spinstr=$temp${spinstr%"$temp"}
                    sleep $delay
                    printf "\r"
                done
                printf "    \n"
            }

            {
                systemctl stop nginx >/dev/null 2>&1
                systemctl stop haproxy >/dev/null 2>&1
                # Check if domain resolves to server IP
                server_ip=$(curl -s ipv4.icanhazip.com)
                domain_ip=$(getent ahosts $new_domain | awk '{print $1}' | head -n 1)

                if [ "$server_ip" != "$domain_ip" ]; then
                    echo -e ""
                    systemctl start nginx >/dev/null 2>&1
                    systemctl start haproxy >/dev/null 2>&1
                    return 1
                fi

                if [ $? -ne 0 ]; then
                    systemctl start nginx >/dev/null 2>&1
                    systemctl start haproxy >/dev/null 2>&1
                    return 1
                fi
                if [ -f /etc/xray/domain ]; then
                    rm -rf /etc/xray/domain >/dev/null 2>&1
                fi
                echo $new_domain > /etc/xray/domain
                if [ $? -ne 0 ]; then
                    echo -e "\n${red}Failed to write new domain ${neutral}"
                    systemctl start nginx >/dev/null 2>&1
                    systemctl start haproxy >/dev/null 2>&1
                    return 1
                fi
                /root/.acme.sh/acme.sh --upgrade --auto-upgrade >/dev/null 2>&1
                /root/.acme.sh/acme.sh --set-default-ca --server letsencrypt >/dev/null 2>&1
                /root/.acme.sh/acme.sh --issue -d $new_domain --standalone -k ec-256 >/dev/null 2>&1
                /root/.acme.sh/acme.sh --installcert -d $new_domain --fullchainpath /etc/xray/xray.crt --keypath /etc/xray/xray.key --ecc >/dev/null 2>&1
                cat /etc/xray/xray.crt /etc/xray/xray.key | tee /etc/haproxy/yha.pem >/dev/null 2>&1
                chown www-data:www-data /etc/xray/xray.key >/dev/null 2>&1
                chown www-data:www-data /etc/xray/xray.crt >/dev/null 2>&1
                systemctl restart haproxy >/dev/null 2>&1
                systemctl restart nginx >/dev/null 2>&1
            } &

            show_loading $! "  Processing domain change"
            # Check previous process status
            wait $!
            process_status=$?

            if [ $process_status -eq 0 ]; then
                if [ "$new_domain" = "$current_domain" ]; then
                    echo -e "\n  ${green}Success: Certificate renewed - $new_domain${neutral}"
                else
                    echo -e "\n  ${green}Success: Domain changed to $new_domain${neutral}"
                fi
                echo -e "  ${yellow}Restart VPS to apply changes${neutral}"
            else
                echo -e "\n${red}Failed to change domain/renew certificate${neutral}"
            fi
            echo -e "${orange}─────────────────────────────────────────${neutral}"
            read -n 1 -s -r -p "Press any key to return to the menu"
        }

        change_ns() {
            clear
            echo -e "${orange}─────────────────────────────────────────${neutral}"
            echo -e "${green}      .:::. CHANGE SLOWDNS DOMAIN .:::.      ${neutral}"
            echo -e "${orange}─────────────────────────────────────────${neutral}"
            echo -e ""

            current_domain=""
            if [ -f /etc/slowdns/domain ]; then
                current_domain=$(tr -d '[:space:]' 2>/dev/null < /etc/slowdns/domain)
            fi
            if [ -z "$current_domain" ]; then
                current_domain=$(tr -d '[:space:]' 2>/dev/null < /etc/xray/dns)
            fi
            if [ -z "$current_domain" ]; then
                current_domain="belum diatur"
            fi
            echo -e "  ${green}Domain saat ini: ${neutral}${current_domain}"

            zone="zdnstt.web.id"
            if [ "$current_domain" != "belum diatur" ]; then
                after_dot="${current_domain#*.}"
                if [ -n "$after_dot" ] && [ "$after_dot" != "$current_domain" ]; then
                    zone="$after_dot"
                fi
            fi

            read -r -p "  Masukkan subdomain DNSTT baru (contoh: asd2): " new_sub
            new_sub=$(printf '%s' "$new_sub" | tr '[:upper:]' '[:lower:]' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

            if [ -z "$new_sub" ]; then
                echo -e "  ${red}Error: subdomain tidak boleh kosong${neutral}"
                read -n 1 -s -r -p "Press any key to return to the menu"
                return
            fi
            if ! printf '%s' "$new_sub" | grep -Eq '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$'; then
                echo -e "  ${red}Error: subdomain tidak valid${neutral}"
                read -n 1 -s -r -p "Press any key to return to the menu"
                return
            fi
            case "$new_sub" in
                ns-*)
                    echo -e "  ${red}Error: subdomain tidak boleh diawali ns-${neutral}"
                    read -n 1 -s -r -p "Press any key to return to the menu"
                    return
                    ;;
            esac

            target="${new_sub}.${zone}"
            echo -e "  ${green}Target: ${neutral}${target}"

            inst_domain=$(tr -d '[:space:]' 2>/dev/null < /etc/xray/domain)
            if [ -z "$inst_domain" ]; then
                if [ "$current_domain" != "belum diatur" ]; then
                    inst_domain="$current_domain"
                else
                    inst_domain="unknown.invalid"
                fi
            fi
            api_resp=$(curl -4 -s -m 25 -X POST "https://zds.web.id/api/slowdns/register" -H "X-API-Key: $(cat /root/.key)" -H "Content-Type: application/json" -d "{\"domain\":\"$inst_domain\",\"sub\":\"$new_sub\"}" 2>/dev/null)
            api_err=$(printf '%s' "$api_resp" | sed -n 's/.*"error"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
            if [ -n "$api_err" ]; then
                if [ "$api_err" = "sub_taken" ]; then
                    echo -e "  ${red}Subdomain sudah dipakai VPS lain; silakan pilih subdomain lain.${neutral}"
                else
                    echo -e "  ${red}Sinkron Cloudflare gagal ($api_err); perubahan dibatalkan.${neutral}"
                fi
                read -n 1 -s -r -p "Press any key to return to the menu"
                return
            fi
            tunnel=$(printf '%s' "$api_resp" | sed -n 's/.*"tunnel_domain"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
            ns_host=$(printf '%s' "$api_resp" | sed -n 's/.*"ns_host"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')

            cloud_ok=0
            if [ -z "$tunnel" ]; then
                echo -e "  ${yellow}Sinkron Cloudflare gagal; record DNS perlu disinkronkan ulang${neutral}"
                new_domain="${new_sub}.${zone}"
            else
                cloud_ok=1
                new_domain="$tunnel"
                if [ -z "$ns_host" ]; then
                    echo -e "  ${yellow}ns_host: -${neutral}"
                else
                    echo -e "  ${green}ns_host: ${neutral}${ns_host}"
                fi
            fi

            if ! printf '%s' "$new_domain" | grep -Eq '^[A-Za-z0-9.-]+$'; then
                echo -e "  ${red}Error: domain tidak valid, dibatalkan${neutral}"
                read -n 1 -s -r -p "Press any key to return to the menu"
                return
            fi
            case "$new_domain" in
                *.*)
                    ;;
                *)
                    echo -e "  ${red}Error: domain tidak valid, dibatalkan${neutral}"
                    read -n 1 -s -r -p "Press any key to return to the menu"
                    return
                    ;;
            esac

            printf '%s\n' "$new_domain" > /etc/slowdns/domain
            chmod 644 /etc/slowdns/domain
            printf '%s\n' "$new_domain" > /etc/xray/dns

            if [ -f /etc/systemd/system/dnstt-server.service ]; then
                printf '%s 127.0.0.1:22\nvm.%s 127.0.0.1:10002\nvl.%s 127.0.0.1:10001\ntr.%s 127.0.0.1:10003\n' "$new_domain" "$new_domain" "$new_domain" "$new_domain" > /etc/slowdns/routes.conf
                chmod 644 /etc/slowdns/routes.conf
                sed -i "s|^ExecStart=.*|ExecStart=/etc/slowdns/dnstt-server -udp 0.0.0.0:5300 -privkey-file /etc/slowdns/server.key -routes-file /etc/slowdns/routes.conf|" /etc/systemd/system/dnstt-server.service
                systemctl daemon-reload
                systemctl restart dnstt-server
                sleep 1
                if systemctl is-active --quiet dnstt-server; then
                    echo -e "  ${green}dnstt-server: GOOD${neutral}"
                else
                    echo -e "  ${red}dnstt-server: BAD${neutral}"
                fi
            else
                echo -e "  ${yellow}dnstt-server belum terpasang; domain disimpan dan akan dipakai saat instalasi/upgrade berikutnya (nyalakan kapan saja lewat opsi 14)${neutral}"
            fi

            echo -e ""
            echo -e "  ${green}Domain baru: ${neutral}${new_domain}"
            if [ -n "$ns_host" ]; then
                echo -e "  ${green}ns host: ${neutral}${ns_host}"
            fi
            if [ "$cloud_ok" = "1" ]; then
                echo -e "  ${yellow}Record DNS lama tidak dihapus otomatis.${neutral}"
            fi
            echo -e "${orange}─────────────────────────────────────────${neutral}"
            read -n 1 -s -r -p "Press any key to return to the menu"
        }

        running() {
            # Function to check service status
            check_status() {
                status=$(systemctl is-active --quiet $1 && echo "active" || echo "inactive")
                if [ "$status" = "active" ]; then
                    echo -e "${green}GOOD${neutral}"
                else
                    echo -e "${red}BAD${neutral}"
                fi
            }

            # Check service status
            services=(
                "ssh" "dropbear" "ws" "nginx" "haproxy"
            )

            for s in "${services[@]}"; do
                declare "$s"="$(check_status $s)"
            done

            # Function to print information
            print_info() {
                printf "   ${yellow}%-19s${neutral} : %-25s\n" "$1" "$2"
            }

            # Print service information
            clear
            echo -e "${orange}─────────────────────────────────────────${neutral}"
            echo -e "${green}       .:::. SYSTEM INFORMATION .:::.        ${neutral}"
            echo -e "${orange}─────────────────────────────────────────${neutral}"
            service_info=(
                "OpenSSH" "${ssh}"
                "Dropbear" "${dropbear}"
                "SSH Websocket" "${ws}"
                "Nginx" "${nginx}"
                "Haproxy" "${haproxy}"
                "Xray vmess" "$(check_status vmess@config)"
                "Xray vless" "$(check_status vless@config)"
                "Xray trojan" "$(check_status trojan@config)"
                "Xray SSocks" "$(check_status shadowsocks@config)"
            )

            for ((i = 0; i < ${#service_info[@]}; i += 2)); do
                print_info "${service_info[i]}" "${service_info[i + 1]}"
            done

            echo -e "${orange}─────────────────────────────────────────${neutral}"
            print_rainbow "─────────────────────────────────────────"
            echo ""
        }

        auto_backup() {
            local status=$(grep -qE "^SHELL" /etc/cron.d/backup && echo -e "\033[32m[ON]\033[0m" || echo -e "\033[31m[OFF]\033[0m")
            clear
            echo -e "${orange}┌──────────────────────────────────────┐${neutral}"
            echo -e "${orange}│${green}         AUTO BACKUP SETTINGS         ${orange}│${neutral}"
            echo -e "${orange}└──────────────────────────────────────┘${neutral}"
            echo -e "${orange}┌──────────────────────────────────────┐${neutral}"
            echo -e "${orange}│${neutral} AutoBackup Status: $status"
            echo -e "${orange}│${neutral} 1) Every 6 Hours"
            echo -e "${orange}│${neutral} 2) Every 1 Day"
            echo -e "${orange}│${neutral} 3) Every 1 Week"
            echo -e "${orange}│${neutral} 4) Every 1 Month"
            echo -e "${orange}│${neutral} 5) Disable AutoBackup"
            echo -e "${orange}│${neutral} x) Exit"
            echo -e "${orange}└──────────────────────────────────────┘${neutral}"
            
            read -p "Choose an option [1-5 or x]: " pilihan
            case $pilihan in
                1) echo -e "SHELL=/bin/sh\nPATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin\n0 */6 * * * root /usr/bin/backuprestore backup" > /etc/cron.d/backup
                clear
                print_rainbow "────────────────────────────────────────"
                echo -e "${orange}│${neutral}"
                echo -e "${orange}│${neutral}      AutoBackup: Every 6 Hours"
                echo -e "${orange}│${neutral}"
                print_rainbow "────────────────────────────────────────"
                service cron restart > /dev/null 2>&1
                ;;
                2) echo -e "SHELL=/bin/sh\nPATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin\n0 0 * * * root /usr/bin/backuprestore backup" > /etc/cron.d/backup
                clear
                print_rainbow "────────────────────────────────────────"
                echo -e "${orange}│${neutral}"
                echo -e "${orange}│${neutral}      AutoBackup: Every 1 Day"
                echo -e "${orange}│${neutral}"
                print_rainbow "────────────────────────────────────────"
                service cron restart > /dev/null 2>&1
                ;;
                3) echo -e "SHELL=/bin/sh\nPATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin\n0 0 * * 7 root /usr/bin/backuprestore backup" > /etc/cron.d/backup
                clear
                print_rainbow "────────────────────────────────────────"
                echo -e "${orange}│${neutral}"
                echo -e "${orange}│${neutral}      AutoBackup: Every 1 Week"
                echo -e "${orange}│${neutral}"
                print_rainbow "────────────────────────────────────────"
                service cron restart > /dev/null 2>&1
                ;;
                4) echo -e "SHELL=/bin/sh\nPATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin\n0 0 1 * * root /usr/bin/backuprestore backup" > /etc/cron.d/backup
                clear
                print_rainbow "────────────────────────────────────────"
                echo -e "${orange}│${neutral}"
                echo -e "${orange}│${neutral}      AutoBackup: Every 1 Month"
                echo -e "${orange}│${neutral}"
                print_rainbow "────────────────────────────────────────"
                service cron restart > /dev/null 2>&1
                ;;
                5) 
                    if [ ! -f /etc/cron.d/backup ]; then
                        clear
                        print_rainbow "────────────────────────────────────────"
                        echo -e "${orange}│${neutral}"
                        echo -e "${orange}│${neutral} AutoBackup Already ${red}Disabled${neutral}"
                        echo -e "${orange}│${neutral}"
                        print_rainbow "────────────────────────────────────────"
                        return
                    fi
                    rm -f /etc/cron.d/backup 
                    clear
                    print_rainbow "────────────────────────────────────────"
                    echo -e "${orange}│${neutral}"
                    echo -e "${orange}│${neutral}      AutoBackup ${red}Disabled${neutral}"
                    echo -e "${orange}│${neutral}"
                    print_rainbow "────────────────────────────────────────"
                    service cron restart > /dev/null 2>&1
                    return
                    ;;
                x|X) clear; return ;;
                *) echo "Invalid choice. Please try again."; return ;;
            esac
        }

        unduh_dnstt() {
            _base="https://zds.web.id/resources"
            _tmpdir="$(mktemp -d)"
            _tmp_manifest="$_tmpdir/checksums.txt"
            _tmp_server="$_tmpdir/dnstt-server.linux.amd64"
            _tmp_client="$_tmpdir/dnstt-client.linux.amd64"

            cleanup() {
                rm -f "$_tmp_manifest" "$_tmp_server" "$_tmp_client"
                rmdir "$_tmpdir" 2>/dev/null || true
            }
            trap cleanup EXIT

            mkdir -p /etc/slowdns
            chmod 700 /etc/slowdns 2>/dev/null || true

            if ! curl -4 -fsSL --connect-timeout 10 --max-time 30 -o "$_tmp_manifest" "$_base/checksums.txt" 2>/dev/null; then
                echo -e "  ${red}Gagal mengunduh manifest dari server, coba lagi nanti${neutral}"
                return 1
            fi

            _download_and_verify() {
                local _name="$1"
                local _tmpfile="$2"
                local _expected
                _expected=$(awk -v n="$_name" '$2==n {print $1}' "$_tmp_manifest" | head -1)
                if [ -z "$_expected" ]; then
                    echo -e "  ${red}Entri $_name tidak ada di manifest${neutral}"
                    return 1
                fi
                if ! curl -4 -fsSL --connect-timeout 10 --max-time 120 -o "$_tmpfile" "$_base/fodder/$_name" 2>/dev/null; then
                    echo -e "  ${red}Gagal mengunduh $_name${neutral}"
                    return 1
                fi
                local _actual
                _actual=$(sha256sum "$_tmpfile" | awk '{print $1}')
                if [ "$_actual" != "$_expected" ]; then
                    echo -e "  ${red}Checksum tidak cocok untuk $_name, unduhan dibatalkan${neutral}"
                    return 1
                fi
                return 0
            }

            if ! _download_and_verify "dnstt-server.linux.amd64" "$_tmp_server"; then
                return 1
            fi
            if ! _download_and_verify "dnstt-client.linux.amd64" "$_tmp_client"; then
                return 1
            fi

            install -m 755 "$_tmp_server" /etc/slowdns/dnstt-server
            install -m 755 "$_tmp_client" /etc/slowdns/dnstt-client

            if [ ! -s /etc/slowdns/server.key ] || [ ! -s /etc/slowdns/server.pub ]; then
                /etc/slowdns/dnstt-server -gen-key -privkey-file /etc/slowdns/server.key -pubkey-file /etc/slowdns/server.pub 2>/dev/null || true
            fi
            chmod 600 /etc/slowdns/server.key 2>/dev/null || true
            chmod 644 /etc/slowdns/server.pub 2>/dev/null || true

            echo -e "  ${green}Biner dnstt terpasang${neutral}"
            return 0
        }

