                            echo -e "  ${red}Batal: biner dnstt belum ada.${neutral}"
                            read -n 1 -s -r -p "Press any key to return to the menu"
                            return
                        fi
                    fi
                    rm -f /etc/slowdns/disabled
                    if [ -f /etc/slowdns/domain.disabled ]; then
                        if [ ! -f /etc/slowdns/domain ]; then
                            mv -f /etc/slowdns/domain.disabled /etc/slowdns/domain 2>/dev/null
                        else
                            rm -f /etc/slowdns/domain.disabled
                        fi
                    fi
                    if [ -f /etc/xray/dns.disabled ] && [ ! -f /etc/xray/dns ]; then
                        mv -f /etc/xray/dns.disabled /etc/xray/dns 2>/dev/null
                    fi
                    if [ ! -f /etc/slowdns/domain ]; then
                        read -p "  Masukkan domain SlowDNS (mis. sub.domain.com): " dom
                        dom=$(printf '%s' "$dom" | tr -d '[:space:]')
                        if printf '%s' "$dom" | grep -Eq '^[A-Za-z0-9.-]+$' && printf '%s' "$dom" | grep -Eq '\.'; then
                            printf '%s\n' "$dom" > /etc/slowdns/domain
                            chmod 644 /etc/slowdns/domain
                            echo -e "  ${yellow}Record DNS akan dicek/didaftarkan otomatis setelah aktivasi.${neutral}"
                        else
                            echo -e "  ${red}Batal: domain tidak valid atau kosong${neutral}"
                            read -n 1 -s -r -p "Press any key to return to the menu"
                            return
                        fi
                    fi
                    domain=$(tr -d '[:space:]' 2>/dev/null < /etc/slowdns/domain)
                    printf '%s 127.0.0.1:22\nvm.%s 127.0.0.1:10002\nvl.%s 127.0.0.1:10001\ntr.%s 127.0.0.1:10003\n' "$domain" "$domain" "$domain" "$domain" > /etc/slowdns/routes.conf
                    chmod 644 /etc/slowdns/routes.conf
                    rm -f /etc/slowdns/routes.conf.disabled
                    cat > /etc/systemd/system/dnstt-server.service <<'EOFUNIT'
[Unit]
Description=ZidStore Tunnel SlowDNS Server (multi-route)
Documentation=https://t.me/zidstoretunnel
After=network.target nss-lookup.target

[Service]
Type=simple
User=root
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/etc/slowdns/dnstt-server -udp 0.0.0.0:5300 -privkey-file /etc/slowdns/server.key -routes-file /etc/slowdns/routes.conf
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOFUNIT
                    chmod 644 /etc/systemd/system/dnstt-server.service
                    systemctl daemon-reload
                    systemctl enable dnstt-server 2>/dev/null
                    systemctl restart dnstt-server 2>/dev/null
                    sleep 1
                    if systemctl is-active --quiet dnstt-server; then
                        echo -e "  ${green}dnstt-server: GOOD${neutral}"
                        # --- R28 ENSURE-RECORDS BEGIN ---
                        _dom=$(tr -d '[:space:]' < /etc/slowdns/domain 2>/dev/null)
                        if [ -n "$_dom" ] && printf '%s' "$_dom" | grep -q '\.'; then
                            _sub="${_dom%%.*}"
                            _zone="${_dom#*.}"
                            if [ "$_zone" = "zdnstt.web.id" ] && [ -f /root/.key ]; then
                                _inst_domain=$(tr -d '[:space:]' < /etc/xray/domain 2>/dev/null)
                                [ -n "$_inst_domain" ] || _inst_domain="$_dom"
                                echo -e "  ${yellow}Memastikan record DNS (${_sub}.${_zone})...${neutral}"
                                _ereg=$(curl -4 -s -m 25 -X POST "https://zds.web.id/api/slowdns/register" -H "X-API-Key: $(cat /root/.key)" -H "Content-Type: application/json" -d "{\"domain\":\"$_inst_domain\",\"sub\":\"$_sub\"}" 2>/dev/null)
                                _eerr=$(printf '%s' "$_ereg" | sed -n 's/.*"error"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
                                _ns_host="ns-${_sub}.${_zone}"
                                _eok=0
                                for _ei in 1 2 3 4 5; do
                                    if getent ahosts "$_ns_host" 2>/dev/null | grep -qE '^[0-9]'; then _eok=1; break; fi
                                    sleep 3
                                done
                                if [ "$_eok" -eq 1 ]; then
                                    echo -e "  ${green}✓ Record DNS siap: ${_ns_host}${neutral}"
                                elif [ -n "$_eerr" ] && [ "$_eerr" != "sub_taken" ]; then
                                    echo -e "  ${yellow}Record belum terverifikasi (${_eerr}); SlowDNS tetap aktif. Cek Cloudflare.${neutral}"
                                else
                                    echo -e "  ${yellow}Record ${_ns_host} belum terlihat (propagasi?); SlowDNS tetap aktif. Cek Cloudflare.${neutral}"
                                fi
                            else
                                echo -e "  ${yellow}Domain di luar zona kelolaan; pastikan record NS/A Cloudflare dibuat manual.${neutral}"
                            fi
                        fi
                        # --- R28 ENSURE-RECORDS END ---
                    else
                        echo -e "  ${red}dnstt-server: BAD${neutral}"
                    fi
                    read -n 1 -s -r -p "Press any key to return to the menu"
                    return
                    ;;
                x|X)
                    read -n 1 -s -r -p "Press any key to return to the menu"
                    return
                    ;;
                *)
                    echo -e "  ${red}Pilihan tidak valid${neutral}"
                    read -n 1 -s -r -p "Press any key to return to the menu"
                    return
                    ;;
            esac
        }

