                2)
                    systemctl stop dnstt-server 2>/dev/null
                    systemctl disable dnstt-server 2>/dev/null
                    if [ -f /etc/slowdns/domain ]; then
                        mv -f /etc/slowdns/domain /etc/slowdns/domain.disabled 2>/dev/null
                    fi
                    if [ -f /etc/slowdns/routes.conf ]; then
                        mv -f /etc/slowdns/routes.conf /etc/slowdns/routes.conf.disabled 2>/dev/null
                    fi
                    if [ -f /etc/xray/dns ]; then
                        mv -f /etc/xray/dns /etc/xray/dns.disabled 2>/dev/null
                    fi
                    rm -f /etc/systemd/system/dnstt-server.service
                    systemctl daemon-reload 2>/dev/null
                    systemctl reset-failed dnstt-server 2>/dev/null || true
                    touch /etc/slowdns/disabled
                    chmod 644 /etc/slowdns/disabled 2>/dev/null
                    echo -e ""
